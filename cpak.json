{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Video Trimmer",
  "description": "Cut videos without re-encoding and export the selected fragment.",
  "version": "26.03.1",
  "image": "ghcr.io/containerpak/video-trimmer@sha256:9bdc08db8e14ab38eb93cab6c6fd49ace6fd9f1b8c6f011c5ac09a992ebefd79",
  "binaries": [
    "/usr/bin/video-trimmer"
  ],
  "desktop_entries": [
    "/usr/share/applications/org.gnome.gitlab.YaLTeR.VideoTrimmer.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": true,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "hostApplications": false,
    "filePicker": {
      "openFile": true,
      "saveFile": true
    },
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": false,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
