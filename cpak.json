{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v2.json",
  "manifest_version": "2.0",
  "name": "Video Trimmer",
  "description": "Cut videos without re-encoding and export the selected fragment.",
  "version": "26.03.1",
  "image": "ghcr.io/containerpak/video-trimmer:main",
  "binaries": ["/usr/bin/video-trimmer"],
  "desktop_entries": ["/usr/share/applications/org.gnome.gitlab.YaLTeR.VideoTrimmer.desktop"],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketX11": true,
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSessionBus": true,
    "socketSystemBus": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "socketAtSpiBus": true,
    "socketBluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": true,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "filesystem": [{"path": "home", "access": "read-write"}],
    "env": [],
    "network": false,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false,
    "allowedHostCommands": ["xdg-open"]
  }
}
