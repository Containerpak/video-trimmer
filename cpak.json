{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Video Trimmer",
  "description": "Cut videos without re-encoding and export the selected fragment.",
  "version": "26.03.1",
  "image": "ghcr.io/containerpak/video-trimmer@sha256:1e869eea916f1a27a50d233252b9e0183da51d838663b7e7f6f336f71bab01b9",
  "binaries": [
    "/usr/bin/video-trimmer"
  ],
  "desktop_entries": [
    "/usr/share/applications/org.gnome.gitlab.YaLTeR.VideoTrimmer.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": true,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": false,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
